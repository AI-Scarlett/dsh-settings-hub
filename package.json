{
  "name": "dsh-settings-hub",
  "version": "0.1.0",
  "description": "A safe, searchable settings directory for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.1",
    "react": ">=18.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-Scarlett/dsh-settings-hub.git"
  },
  "homepage": "https://github.com/AI-Scarlett/dsh-settings-hub#readme",
  "bugs": {
    "url": "https://github.com/AI-Scarlett/dsh-settings-hub/issues"
  },
  "scripts": {
    "check": "node --check index.mjs && node --check lib/client.js && npm test",
    "test": "node --test \"test/*.test.mjs\""
  }
}

